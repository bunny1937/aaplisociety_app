{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "test:unit": { "dependsOn": ["^build"] },
    "test:integration": { "dependsOn": ["^build"] },
    "test:api": { "dependsOn": ["^build"] },
    "test:security": { "dependsOn": ["^build"] },
    "test:performance": { "dependsOn": ["^build"] },
    "test:coverage": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "test:all": { "dependsOn": ["^build"] },
    "test:watch": { "cache": false, "persistent": true },
    "dev": { "cache": false, "persistent": true }
  }
}
