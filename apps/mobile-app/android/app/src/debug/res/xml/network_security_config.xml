<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug-only: allow plain HTTP so a physical device can reach a dev machine's LAN IP.
         Release build has no config, so cleartext stays blocked there (HTTPS-only). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
